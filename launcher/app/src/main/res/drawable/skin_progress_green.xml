<?xml version="1.0" encoding="utf-8"?>
<!-- Jadwal sholat skins: how far it is from the last prayer to the next. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#FF4ADE80" /><corners android:radius="3dp" /></shape></clip>
    </item>
</layer-list>
