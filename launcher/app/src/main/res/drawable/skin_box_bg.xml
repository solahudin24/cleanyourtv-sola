<?xml version="1.0" encoding="utf-8"?>
<!-- Jadwal sholat skins: the inner panels (countdown box, the row of five times). A dark tint, so they stay
     darker than the card around them even where the wallpaper behind is bright, and green text reads on them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#40000000" />
    <stroke android:width="1dp" android:color="#14FFFFFF" />
    <corners android:radius="12dp" />
</shape>
